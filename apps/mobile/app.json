{
  "expo": {
    "name": "Bopay",
    "slug": "bopay",
    "owner": "bopay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bopay",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6C47FF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.bopay.app",
      "infoPlist": {
        "NFCReaderUsageDescription": "Bopay utilise le NFC pour accepter les paiements sans contact.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {}
    },
    "android": {
      "package": "fr.bopay.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6C47FF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5be4907b-fb4f-4d45-a305-00926c028872"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5be4907b-fb4f-4d45-a305-00926c028872"
    }
  }
}
